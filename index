    var order = ["home", "works", "case-study", "resume", "about", "contact"];
    var toolbar = document.getElementById("toolbar");
    var sideNav = document.getElementById("sideNav");
    var content = document.getElementById("content");
    var addressBar = document.getElementById("addressBar");
    var statusText = document.getElementById("statusText");
    var homeBtn = document.getElementById("homeBtn");

    function buildNav() {
      toolbar.innerHTML = ""; sideNav.innerHTML = "";
      order.forEach(function(key) {
        var page = pages[key];
        var tool = document.createElement("button");
        tool.className = "tool-btn"; tool.dataset.key = key;
        tool.innerHTML = '<span class="tool-icon"></span><span>' + page.title + '</span>';
        tool.addEventListener("click", function() { goTo(key); });
        toolbar.appendChild(tool);
        var link = document.createElement("a");
        link.className = "nav-link"; link.href = "#" + key; link.textContent = page.title;
        sideNav.appendChild(link);
      });
    }

    function currentKey() {
      var hash = window.location.hash.replace("#","");
      return pages[hash] ? hash : "home";
    }
    function goTo(key) { window.location.hash = key; }
    function render() {
      var key = currentKey(); var page = pages[key];
      document.title = page.title + " - Lauren Cho Portfolio";
      content.innerHTML = page.body;
      addressBar.textContent = page.path;
      statusText.textContent = "opened " + page.title.toLowerCase();
      document.querySelectorAll(".nav-link").forEach(function(el) {
        el.classList.toggle("active", el.getAttribute("href") === "#" + key);
      });
      document.querySelectorAll(".tool-btn").forEach(function(el) {
        el.classList.toggle("active", el.dataset.key === key);
      });
    }
    homeBtn.addEventListener("click", function() { goTo("home"); });
    window.addEventListener("hashchange", render);
    buildNav(); render();
  </script>
